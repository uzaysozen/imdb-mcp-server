# Copy to .env and fill in your own key.
# Get one by subscribing to the IMDb API on RapidAPI:
# https://rapidapi.com/octopusteam-octopusteam-default/api/imdb236
RAPID_API_KEY_IMDB=your_api_key_here

# Optional: HTTP transport settings (only used when TRANSPORT=http)
# TRANSPORT=http
# HOST=0.0.0.0
# PORT=8081
